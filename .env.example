PORT=8080
NODE_ENV=development

# Comma-separated frontend origins. Use * only for local testing.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# On a reverse-proxy host (Render/Nginx/Cloudflare), set 1 so IP rate limits work correctly.
TRUST_PROXY=0

# Meta Graph API
META_API_VERSION=v23.0
META_ACCESS_TOKEN=replace_with_a_long_lived_user_access_token
INSTAGRAM_USER_ID=replace_with_authorized_instagram_professional_account_id

# Limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
MAX_META_PAGES=10

# Recommended public-media provider: your own Cobalt instance
COBALT_API_URL=https://your-cobalt-instance.example.com
# Optional when your Cobalt instance uses Api-Key authentication
COBALT_API_KEY=replace_with_cobalt_api_key

# Optional Cloudflare Worker media offload. Use the same random secret in Render and Worker.
MEDIA_WORKER_URL=https://reelssaver-media.your-account.workers.dev
DOWNLOAD_SIGNING_SECRET=replace_with_at_least_32_random_bytes

# Optional Instagram session fallback (testing / your own permitted media only)
# Use the full Cookie request header value, not only sessionid when possible.
IG_COOKIE=sessionid=...; csrftoken=...; ds_user_id=...
# Optional; automatically extracted from IG_COOKIE when present.
IG_CSRF_TOKEN=
# Optional override if Instagram changes its GraphQL query IDs
IG_GRAPHQL_DOC_IDS=24368985919464652,8845758582119845,10015901848480474
# Real live-feed profiles (comma-separated public Instagram usernames)
IG_FEED_USERNAMES=instagram
# Optional separate dedicated account session for Live Feed.
IG_FEED_SESSIONID=
# Optional override; normally extracted from the URL-encoded session ID.
IG_FEED_USER_ID=

# Local self-hosted Story resolver (use a dedicated Instagram account)
IG_STORY_USERNAME=your_dedicated_instagram_username
IG_STORY_PASSWORD=your_dedicated_instagram_password
# Optional alternative when password login is blocked by a manual challenge.
IG_STORY_SESSIONID=
# Fill temporarily only when Instagram requests 2FA, then clear it after session creation.
IG_STORY_VERIFICATION_CODE=
IG_STORY_SESSION_FILE=./story-session.json
# Windows normally uses python; change to py if that is your installed launcher.
STORY_PYTHON_COMMAND=python
